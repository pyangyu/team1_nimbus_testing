        <mxCell id="runfiles" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="3. 组装 config / manifest&#xa;ensure_run_files() 创建或核对配置与题目清单" vertex="1">
