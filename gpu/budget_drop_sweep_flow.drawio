        <mxCell id="phasea" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="Phase A：自然推理基线&#xa;read_jsonl(phase_a.jsonl) 检查已有轨迹&#xa;缺少的样本调用 Engine/Mock.generate()；stable_seed() 固定样本随机种子&#xa;append_jsonl() 保存轨迹，支持中断后续跑" vertex="1">
          <mxGeometry height="105" width="600" x="400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="parsephasea" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="natural_records()&#xa;trace_fields() 解析 think 边界、长度 L 和 capped 状态&#xa;behavior_metrics() + TB.grade() 计算自然推理基线&#xa;写入 natural.jsonl" vertex="1">
          <mxGeometry height="95" width="600" x="400" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="phaseb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="Phase B：run_drop_tests()&#xa;逐条自然轨迹 × 每个实验组，跳过已完成 arm&#xa;add_cut_and_size() 把相对 L 的比例换算成 token 数" vertex="1">
          <mxGeometry height="85" width="600" x="400" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="arms" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="构造实验输入&#xa;cut_now / silent：复用自然推理前缀&#xa;warn_soft / warn_count：前缀 + 提示，再生成续写&#xa;resample：从原题重新生成，预算为 cut + window" vertex="1">
          <mxGeometry height="100" width="340" x="210" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="continue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="warn / resample 续写&#xa;Engine/Mock.generate(stop_ids)&#xa;clean_thinking_ids() 处理边界标记" vertex="1">
